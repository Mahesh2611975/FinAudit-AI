# =============================================================================
# FinAudit AI — PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy the relevant section into the hosting provider's dashboard. NEVER commit
# a populated .env file. Values marked [SET IN DASHBOARD] are secrets or
# deployment-specific URLs and must be provided at deploy time.

# -----------------------------------------------------------------------------
# Backend (Render Web Service)
# -----------------------------------------------------------------------------
# PostgreSQL connection string from Neon (or Render Postgres). Use the
# pooled connection string for serverless deployments:
FINAUDIT_DATABASE_URL=[SET IN DASHBOARD]

# Comma-separated frontend origins allowed by CORS (no trailing slash).
# e.g. https://finaudit-abc123.vercel.app,https://finaudit.yourdomain.com
FINAUDIT_CORS_ORIGINS=[SET IN DASHBOARD]

# Must be explicitly non-local: the backend refuses to start if the JWT
# signing secret is missing or too weak in production, staging or any other
# non-local environment. For staging use FINAUDIT_ENV=staging and a separate
# secret; never reuse the production value.
FINAUDIT_ENV=production

# JWT SIGNING SECRET — REQUIRED. Generate a unique value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use at least 32 random characters. Set it in the hosting dashboard only;
# never commit the generated value. Rotating it invalidates existing sessions.
FINAUDIT_JWT_SECRET=[SET IN DASHBOARD]
FINAUDIT_JWT_ALGORITHM=HS256

# Demo sessions are refused outside local environments regardless of this
# flag; keeping it false documents the intended production configuration.
FINAUDIT_LOCAL_DEMO_MODE=false

# Hosted Ollama-compatible inference endpoint reachable from the backend.
# A local 127.0.0.1 Ollama on a developer laptop is NOT reachable from Render.
# If this is unset/unreachable, deterministic rules still run and the assistant
# returns evidence-only answers (no fabricated facts).
OLLAMA_HOST=[SET IN DASHBOARD]
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=20
OLLAMA_PROBE_TIMEOUT=1.5

# Optional, free geocoding (results cached in the database). Off by default.
FINAUDIT_GEOCODING_ENABLED=false
FINAUDIT_GEOCODING_MAX_LOOKUPS=10

# -----------------------------------------------------------------------------
# Frontend (Vercel)
# -----------------------------------------------------------------------------
# Public URL of the Render backend. Embedded at BUILD time by Vite.
VITE_API_URL=[SET IN DASHBOARD]
# Demo navigation is off by default; the backend is authoritative and refuses
# demo sessions outside local environments even if this flag is set to true.
VITE_LOCAL_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# * No paid LLM API keys are used or required.
# * Authentication, bcrypt password hashing and JWT/RBAC are enabled. Set a
#   strong FINAUDIT_JWT_SECRET before deploying; a missing or weak secret is a
#   fatal configuration error, never a fallback to a development value.
# * Provision the first administrator explicitly with `python -m app.create_admin`;
#   there are no default credentials and self-registration requires approval.
# * Local SQLite backups are created automatically before additive migrations;
#   PostgreSQL deployments should snapshot the database before schema changes.
