# Copy this file to backend/.env (the backend loads backend/.env by path).
# FinAudit AI runs fully locally with Ollama. No paid LLM API key is required.

# Local Ollama settings
OLLAMA_HOST=http://127.0.0.1:11434
# Small model suitable for an 8 GB laptop. Pull it once: ollama pull llama3.2:1b
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=20
OLLAMA_PROBE_TIMEOUT=1.5

# Optional database override, e.g. sqlite:///./data/finaudit.db
# FINAUDIT_DATABASE_URL=

# Optional free geocoding for city/country values without coordinates.
# Results are cached in SQLite; no paid API is required.
# FINAUDIT_GEOCODING_ENABLED=false
# FINAUDIT_GEOCODING_MAX_LOOKUPS=10

# Authentication / RBAC (copy these into backend/.env when needed).
# Locally a blank value uses a development-only fallback. Production, staging
# and all other non-local environments require a strong secret (>= 32 random
# characters) or the backend fails closed at startup.
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# FINAUDIT_JWT_SECRET=
# FINAUDIT_JWT_ALGORITHM=HS256
# FINAUDIT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Local demo only: enable in backend/.env and frontend/.env together.
# FINAUDIT_ENV=local
# FINAUDIT_LOCAL_DEMO_MODE=false
# VITE_LOCAL_DEMO_MODE=false
# Never commit a real FINAUDIT_ADMIN_PASSWORD. Create the first admin with:
#   cd backend
#   python -m app.create_admin --username admin --email admin@example.com
