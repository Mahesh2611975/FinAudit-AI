# Vite reads this file from the frontend/ directory at dev/build time.
# It must point to the FastAPI server root, not to a /api path.
VITE_API_URL=http://127.0.0.1:8000

# LOCAL DEMO MODE (disabled by default). Set to true only on a local machine,
# together with FINAUDIT_ENV=local and FINAUDIT_LOCAL_DEMO_MODE=true in the
# backend. This only removes sign-in/registration screens from navigation;
# the backend refuses demo sessions in production and staging.
VITE_LOCAL_DEMO_MODE=false

# If the browser opens the frontend as http://localhost:5173, either use that
# host here or make sure FINAUDIT_CORS_ORIGINS in backend/.env includes it.
