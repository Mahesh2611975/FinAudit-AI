# Vite reads this file from the frontend/ directory at dev/build time.
# It must point to the FastAPI server root, not to a /api path.
VITE_API_URL=http://127.0.0.1:8000

# LOCAL DEMO MODE (disabled by default). Set to true only alongside the backend
# FINAUDIT_LOCAL_DEMO_MODE=true flag. This removes sign-in/registration screens
# from navigation; the backend still issues the signed demo session.
VITE_LOCAL_DEMO_MODE=true

# If the browser opens the frontend as http://localhost:5173, either use that
# host here or make sure FINAUDIT_CORS_ORIGINS in backend/.env includes it.
