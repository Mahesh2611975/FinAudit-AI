GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FINAUDIT_DATABASE_URL=sqlite:///./data/finaudit.db
VITE_API_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Optional free geocoding for rows that have city/state/country but no
# latitude/longitude. Disabled by default; results are cached in SQLite.
FINAUDIT_GEOCODING_ENABLED=false
FINAUDIT_GEOCODING_MAX_LOOKUPS=10
