# SQLite database used by the FastAPI application.
FINAUDIT_DATABASE_URL=sqlite:///./data/finaudit.db

# Frontend API base URL (used when building the React app).
VITE_API_URL=http://127.0.0.1:8000

# Local Ollama daemon. No API key or paid account is required.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# Optional timeouts in seconds.
OLLAMA_TIMEOUT=20
OLLAMA_PROBE_TIMEOUT=1.5

# Optional free geocoding for rows that have city/state/country but no
# latitude/longitude. Disabled by default; results are cached in SQLite.
FINAUDIT_GEOCODING_ENABLED=false
FINAUDIT_GEOCODING_MAX_LOOKUPS=10

# Optional CORS origins for a non-local frontend (comma-separated).
FINAUDIT_CORS_ORIGINS=
