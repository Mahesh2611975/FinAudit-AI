# SQLite database used by the FastAPI application.
FINAUDIT_DATABASE_URL=sqlite:///./data/finaudit.db

# Frontend API base URL (used when building the React app).
VITE_API_URL=http://127.0.0.1:8000

# Local Ollama daemon. No API key or paid account is required.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# Optional timeouts in seconds.
OLLAMA_TIMEOUT=20
OLLAMA_PROBE_TIMEOUT=1.5

# Optional free geocoding for rows that have city/state/country but no
# latitude/longitude. Disabled by default; results are cached in SQLite.
FINAUDIT_GEOCODING_ENABLED=false
FINAUDIT_GEOCODING_MAX_LOOKUPS=10

# Optional CORS origins for a non-local frontend (comma-separated).
# Local Vite origins (5173-5175, 4173, 3000 on localhost/127.0.0.1) are allowed
# by default. Set this only when serving the frontend from another origin.
FINAUDIT_CORS_ORIGINS=

# Authentication / RBAC. Locally, leaving this blank uses a documented
# development-only secret (so tokens survive restarts). In production, staging
# and every other non-local environment the backend refuses to start unless
# this is a strong random value of at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINAUDIT_JWT_SECRET=
FINAUDIT_JWT_ALGORITHM=HS256
FINAUDIT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LOCAL DEMO MODE (disabled by default).
# Set both flags only for a local machine to skip sign-in/registration screens.
# FINAUDIT_ENV=production (or prod/staging) always disables demo mode, even if
# FINAUDIT_LOCAL_DEMO_MODE=true is present. No database records are created.
FINAUDIT_ENV=local
FINAUDIT_LOCAL_DEMO_MODE=false
# Optional short-lived demo session lifetime in minutes (default 30).
FINAUDIT_DEMO_TOKEN_MINUTES=30

# ONE-TIME ADMIN BOOTSTRAP ONLY. Do not leave a real password in this file.
# Prefer: python -m app.create_admin --username admin --email admin@example.com
# and type the password at the interactive prompt. The CLI also accepts this
# variable for automated setup, but the value must be removed afterwards.
# FINAUDIT_ADMIN_PASSWORD=
