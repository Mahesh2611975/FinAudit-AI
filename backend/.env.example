# Copy this file to backend/.env and fill in your own Groq API key.
# Never commit backend/.env or share a real key.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Optional database override. Defaults to backend/data/finaudit.db.
# FINAUDIT_DATABASE_URL=sqlite:///./data/finaudit.db
